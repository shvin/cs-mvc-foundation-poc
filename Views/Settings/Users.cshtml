@{
    ViewData["Title"] = "Users";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-semibold mb-1">User Management</h4>
            <p class="text-muted mb-0">Admin-only. Manage team members and role assignments.</p>
        </div>
        <button class="btn btn-primary btn-sm px-3">+ Invite User</button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 fw-semibold text-muted small">Name</th>
                        <th class="py-3 fw-semibold text-muted small">Email</th>
                        <th class="py-3 fw-semibold text-muted small">Role</th>
                        <th class="py-3 fw-semibold text-muted small">Status</th>
                        <th class="py-3 fw-semibold text-muted small"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in new[] {
                        new { Name = "Alice M.",  Email = "alice@cs.internal",  Role = "Admin",   Active = true  },
                        new { Name = "Bob T.",    Email = "bob@cs.internal",    Role = "Manager", Active = true  },
                        new { Name = "Carol S.",  Email = "carol@cs.internal",  Role = "Viewer",  Active = true  },
                        new { Name = "David R.",  Email = "david@cs.internal",  Role = "Manager", Active = true  },
                        new { Name = "Eve L.",    Email = "eve@cs.internal",    Role = "Viewer",  Active = false },
                    })
                    {
                        var roleColor = user.Role switch { "Admin" => "danger", "Manager" => "primary", _ => "secondary" };
                        <tr>
                            <td class="ps-4 py-3 fw-medium">@user.Name</td>
                            <td class="py-3 text-muted small">@user.Email</td>
                            <td class="py-3"><span class="badge bg-@(roleColor)-subtle text-@(roleColor)">@user.Role</span></td>
                            <td class="py-3">
                                <span class="badge @(user.Active ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                    @(user.Active ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="py-3"><a href="#" class="text-muted small">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
