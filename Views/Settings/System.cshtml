@{
    ViewData["Title"] = "System Settings";
}

<div class="container-fluid p-4">
    <div class="mb-4">
        <h4 class="fw-semibold mb-1">System Settings</h4>
        <p class="text-muted mb-0">Admin-only. Application configuration and integrations.</p>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-bottom pt-3 pb-2">
                    <h6 class="mb-0 fw-semibold">General</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Application Name</label>
                        <input type="text" class="form-control" value="Project Hub" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Support Email</label>
                        <input type="email" class="form-control" value="support@cs.internal" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-semibold">Default Timezone</label>
                        <select class="form-select">
                            <option selected>UTC</option>
                            <option>America/New_York</option>
                            <option>Europe/London</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-bottom pt-3 pb-2">
                    <h6 class="mb-0 fw-semibold">Authentication</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <div class="fw-medium small">Cookie Expiry</div>
                            <div class="text-muted small">Session timeout duration</div>
                        </div>
                        <span class="badge bg-secondary-subtle text-secondary">60 min</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <div class="fw-medium small">Sliding Expiration</div>
                            <div class="text-muted small">Reset timeout on activity</div>
                        </div>
                        <span class="badge bg-success-subtle text-success">Enabled</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-medium small">Secure Cookies</div>
                            <div class="text-muted small">HTTPS-only cookie policy</div>
                        </div>
                        <span class="badge bg-success-subtle text-success">Always</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
