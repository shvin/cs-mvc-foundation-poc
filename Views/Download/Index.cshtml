@model List<string>
@{
    ViewData["Title"] = "Downloads";
}

<div class="container-fluid p-4">
    <div class="mb-4">
        <h4 class="fw-semibold mb-1">Downloads</h4>
        <p class="text-muted mb-0">Files available for download from the CSS folder.</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert border-0 shadow-sm text-muted">No files found.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <ul class="list-group list-group-flush">
                @foreach (var file in Model)
                {
                    <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" class="text-secondary" style="flex-shrink:0;">
                                <path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                            </svg>
                            <span class="fw-medium">@file</span>
                        </div>
                        <a href="@Url.Action("File", "Download", new { name = file })"
                           class="btn btn-sm btn-outline-primary px-3">
                            Download
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
