@{
    ViewData["Title"] = "Reports";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-semibold mb-1">Reports</h4>
            <p class="text-muted mb-0">Activity and usage reports. Visible to Admins and Managers only.</p>
        </div>
        <button class="btn btn-outline-secondary btn-sm px-3">Export CSV</button>
    </div>

    <!-- RBAC notice card -->
    <div class="alert border-0 shadow-sm d-flex gap-2 align-items-center mb-4" style="background:#f0fdf4; border-left:4px solid #16a34a !important;">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" style="color:#16a34a; flex-shrink:0;">
            <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="small">You are seeing this page because you have the <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong> role. Viewer role users cannot access this section.</span>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var report in new[] {
            new { Title = "Project Velocity",    Desc = "Task completion rate over time",              Updated = "Today",      Icon = "📈" },
            new { Title = "Team Utilisation",    Desc = "Hours logged per team member this sprint",    Updated = "Today",      Icon = "👥" },
            new { Title = "Bug Trend",           Desc = "Bugs opened vs closed over the last 8 weeks", Updated = "Yesterday",  Icon = "🐛" },
            new { Title = "Deployment Freq.",    Desc = "Releases per week across all projects",        Updated = "2 days ago", Icon = "🚀" },
        })
        {
            <div class="col-12 col-md-6">
                <div class="card border-0 shadow-sm h-100" style="cursor:pointer;">
                    <div class="card-body d-flex gap-3 align-items-center">
                        <div class="fs-3">@report.Icon</div>
                        <div>
                            <div class="fw-semibold">@report.Title</div>
                            <div class="text-muted small">@report.Desc</div>
                            <div class="text-muted small mt-1">Updated @report.Updated</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
