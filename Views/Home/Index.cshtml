@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid p-4">

    <div class="mb-4">
        <h4 class="fw-semibold mb-1">Welcome back</h4>
        <p class="text-muted mb-0">Here's what's happening across your projects today.</p>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Active Projects</p>
                            <h3 class="fw-bold mb-0">12</h3>
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">+2 this month</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Open Tasks</p>
                            <h3 class="fw-bold mb-0">48</h3>
                        </div>
                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2">8 overdue</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Team Members</p>
                            <h3 class="fw-bold mb-0">9</h3>
                        </div>
                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">All active</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Completed This Week</p>
                            <h3 class="fw-bold mb-0">23</h3>
                        </div>
                        <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">↑ 14%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent activity -->
    <div class="row g-3">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-semibold">Recent Activity</h6>
                    <a href="/projects" class="btn btn-sm btn-outline-secondary">View all</a>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in new[] {
                            new { Who = "Alice M.",  Action = "completed task",     Target = "API integration spec",   When = "2h ago",   Color = "success" },
                            new { Who = "Bob T.",    Action = "opened PR for",      Target = "Authentication module",  When = "3h ago",   Color = "primary" },
                            new { Who = "Carol S.",  Action = "commented on",       Target = "Dashboard redesign",     When = "5h ago",   Color = "secondary" },
                            new { Who = "David R.",  Action = "created project",    Target = "Q3 Analytics Platform",  When = "Yesterday",Color = "primary" },
                            new { Who = "Eve L.",    Action = "marked overdue",     Target = "Deployment checklist",   When = "Yesterday",Color = "warning" },
                        })
                        {
                            <li class="list-group-item px-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-xs bg-@(item.Color)-subtle text-@(item.Color) rounded-circle d-flex align-items-center justify-content-center fw-semibold" style="width:32px;height:32px;flex-shrink:0;font-size:.75rem;">
                                        @item.Who[0]
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <span class="fw-medium">@item.Who</span>
                                        <span class="text-muted"> @item.Action </span>
                                        <span class="fw-medium">@item.Target</span>
                                    </div>
                                    <small class="text-muted text-nowrap">@item.When</small>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-bottom pt-3 pb-2">
                    <h6 class="mb-0 fw-semibold">My Tasks</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var task in new[] {
                            new { Name = "Review design mockups",       Due = "Today",    Done = false },
                            new { Name = "Update API documentation",    Due = "Tomorrow", Done = false },
                            new { Name = "Fix login redirect bug",      Due = "Overdue",  Done = false },
                            new { Name = "Set up staging environment",  Due = "Fri",      Done = true  },
                            new { Name = "Write unit tests for parser", Due = "Next week",Done = false },
                        })
                        {
                            <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <input class="form-check-input mt-0" type="checkbox" @(task.Done ? "checked" : "") disabled />
                                    <span class="@(task.Done ? "text-decoration-line-through text-muted" : "")">@task.Name</span>
                                </div>
                                <span class="badge @(task.Due == "Overdue" ? "bg-danger-subtle text-danger" : "bg-secondary-subtle text-secondary") rounded-pill">@task.Due</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

</div>
