@{
    ViewData["Title"] = "Projects";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-semibold mb-1">Projects</h4>
            <p class="text-muted mb-0">Manage and track your team's projects.</p>
        </div>
        <button class="btn btn-primary btn-sm px-3">+ New Project</button>
    </div>

    <div class="row g-3">
        @foreach (var project in new[] {
            new { Name = "Q3 Analytics Platform", Status = "Active",     Progress = 65, Members = 4, Tasks = 14, Updated = "Today" },
            new { Name = "Auth Module Upgrade",   Status = "Active",     Progress = 40, Members = 2, Tasks = 8,  Updated = "Yesterday" },
            new { Name = "Mobile App v2",         Status = "In Review",  Progress = 90, Members = 5, Tasks = 3,  Updated = "2 days ago" },
            new { Name = "Data Pipeline",         Status = "On Hold",    Progress = 25, Members = 3, Tasks = 21, Updated = "1 week ago" },
            new { Name = "Dashboard Redesign",    Status = "Active",     Progress = 55, Members = 3, Tasks = 11, Updated = "Today" },
            new { Name = "API v3 Migration",      Status = "Planning",   Progress = 10, Members = 6, Tasks = 32, Updated = "3 days ago" },
        })
        {
            var statusColor = project.Status switch {
                "Active"    => "success",
                "In Review" => "primary",
                "On Hold"   => "warning",
                "Planning"  => "secondary",
                _           => "secondary"
            };
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h6 class="fw-semibold mb-0">@project.Name</h6>
                            <span class="badge bg-@(statusColor)-subtle text-@(statusColor) rounded-pill">@project.Status</span>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Progress</span>
                                <span>@(project.Progress)%</span>
                            </div>
                            <div class="progress" style="height:6px;">
                                <div class="progress-bar bg-primary" style="width:@(project.Progress)%"></div>
                            </div>
                        </div>
                        <div class="d-flex gap-3 text-muted small">
                            <span>@(project.Members) members</span>
                            <span>@(project.Tasks) tasks</span>
                            <span class="ms-auto">@project.Updated</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
