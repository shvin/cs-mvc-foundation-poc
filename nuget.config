<?xml version="1.0" encoding="utf-8"?>
<!--
  Configure the GitHub Packages NuGet feed for CS shared libraries.

  USERNAME : your GitHub username
  TOKEN    : a GitHub PAT with read:packages scope

  For local development you can instead store credentials in
  %APPDATA%\NuGet\NuGet.Config (Windows) or ~/.nuget/NuGet/NuGet.Config (Linux/macOS)
  so they are not committed to source control.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="cs-shared" value="https://nuget.pkg.github.com/shvin/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <cs-shared>
      <add key="Username" value="%NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%NUGET_TOKEN%" />
    </cs-shared>
  </packageSourceCredentials>
</configuration>
